# SPDX-License-Identifier: Apache-2.0

include armv8-m/Make.defs

CHIP_CSRCS += ra_start.c ra_clockconfig.c ra_irq.c ra_icu.c ra_gpio.c
CHIP_CSRCS += ra_pinmux.c
CHIP_CSRCS += ra_allocateheap.c ra_timerisr.c ra_serial.c
ifeq ($(CONFIG_RA8P1_SDRAM),y)
CHIP_CSRCS += ra_sdram.c
endif
ifeq ($(CONFIG_RA8P1_I2C),y)
CHIP_CSRCS += ra_i2c.c
endif
ifeq ($(CONFIG_RA8P1_OSPI_B),y)
CHIP_CSRCS += ra_ospi.c
endif
ifeq ($(CONFIG_RA8P1_SDHI0),y)
CHIP_CSRCS += ra_sdhi.c
endif
ifeq ($(CONFIG_RA8P1_SPI1),y)
CHIP_CSRCS += ra_spi.c
endif
ifeq ($(CONFIG_RA8P1_CANFD0),y)
CHIP_CSRCS += ra_canfd.c
endif
ifeq ($(CONFIG_RA8P1_GPT_PWM),y)
CHIP_CSRCS += ra_pwm.c
endif
ifeq ($(CONFIG_RA8P1_ADC_B),y)
CHIP_CSRCS += ra_adc.c
endif
ifeq ($(CONFIG_RA8P1_RTC),y)
CHIP_CSRCS += ra_rtc.c
endif
ifeq ($(CONFIG_RA8P1_WDT),y)
CHIP_CSRCS += ra_wdt.c
endif
ifeq ($(CONFIG_RA8P1_USBFS),y)
CHIP_CSRCS += ra_usbdev.c
endif
ifeq ($(CONFIG_RA8P1_SSI0),y)
CHIP_CSRCS += ra_i2s.c
endif
ifeq ($(CONFIG_RA8P1_ETHOSU55),y)
INCLUDES += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)drivers$(DELIM)aie$(DELIM)ethosu
CHIP_CSRCS += ra_ethosu.c
endif
ifeq ($(CONFIG_RA8P1_ETHERNET),y)
CHIP_CSRCS += ra_ethernet.c
endif
ifeq ($(CONFIG_RA8P1_CAMERA),y)
CHIP_CSRCS += ra_camera.c
endif
